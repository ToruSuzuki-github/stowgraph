# Python artifacts (each person recreates the virtual environment by following "Set up" in the README)
.venv/
__pycache__/
*.py[cod]

# JSON generated by generate.py from each person's own Docker state (contents differ per person). Keep only the folder
repos/*
!repos/.gitkeep

# Personal Claude Code settings, and sidecar files created when copying from Windows
.claude/settings.local.json
*:Zone.Identifier
